# Three individually identified rigid obstacles. Their collision shapes and
# physical bodies are real; scoring uses the measured overlap of the car box.
DEF CONE_1 Solid {
  translation -1.45 -2.00 0.13
  children [ Shape { appearance PBRAppearance { baseColor 1 0.32 0.045 roughness 0.65 } geometry Cone { bottomRadius 0.12 height 0.25 } } ]
  name "kužel 1"
  contactMaterial "cone"
  boundingObject Cylinder { height 0.25 radius 0.12 }
  physics Physics { density -1 mass 0.22 }
}
DEF CONE_2 Solid {
  translation 0.47 0.35 0.13
  children [ Shape { appearance PBRAppearance { baseColor 1 0.32 0.045 roughness 0.65 } geometry Cone { bottomRadius 0.12 height 0.25 } } ]
  name "kužel 2"
  contactMaterial "cone"
  boundingObject Cylinder { height 0.25 radius 0.12 }
  physics Physics { density -1 mass 0.22 }
}
DEF CONE_3 Solid {
  translation 2.55 1.03 0.13
  children [ Shape { appearance PBRAppearance { baseColor 1 0.32 0.045 roughness 0.65 } geometry Cone { bottomRadius 0.12 height 0.25 } } ]
  name "kužel 3"
  contactMaterial "cone"
  boundingObject Cylinder { height 0.25 radius 0.12 }
  physics Physics { density -1 mass 0.22 }
}

# Low-intensity decorative LED blocks along the outer arena edges.
Transform { translation 0 -3.48 0.015 children [ Shape { appearance PBRAppearance { baseColor 0.0 0.75 0.78 emissiveColor 0.0 0.16 0.18 } geometry Box { size 5.7 0.025 0.02 } } ] }
Transform { translation 0 3.48 0.015 children [ Shape { appearance PBRAppearance { baseColor 0.0 0.75 0.78 emissiveColor 0.0 0.16 0.18 } geometry Box { size 5.7 0.025 0.02 } } ] }
Transform { translation -5.88 0 0.015 children [ Shape { appearance PBRAppearance { baseColor 0.0 0.75 0.78 emissiveColor 0.0 0.16 0.18 } geometry Box { size 0.025 6.9 0.02 } } ] }
Transform { translation 5.88 0 0.015 children [ Shape { appearance PBRAppearance { baseColor 0.0 0.75 0.78 emissiveColor 0.0 0.16 0.18 } geometry Box { size 0.025 6.9 0.02 } } ] }

