Transform { translation -2.55 -1.08 0.03 children [
  Transform { translation -0.13 0 0 children [
    Transform { translation 0 0.12 0 children [ Shape { appearance DEF NUM_MAT PBRAppearance { baseColor 0.98 0.72 0.12 emissiveColor 0.2 0.1 0.0 } geometry Box { size 0.17 0.025 0.008 } } ] }
    Transform { translation 0.075 0.06 0 children [ Shape { appearance USE NUM_MAT geometry Box { size 0.025 0.09 0.008 } } ] }
